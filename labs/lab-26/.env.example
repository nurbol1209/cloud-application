APP_NAME=Cloud Application
APP_VERSION=1.0
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true
API_PREFIX=/api

# Локальный учебный режим без PostgreSQL:
DB_BACKEND=sqlite
# Целевой режим PostgreSQL:
# DB_BACKEND=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloud_application
DB_USER=postgres

STORAGE_PATH=storage/objects
MAX_UPLOAD_SIZE=5242880

HTTPS_ENABLED=false
HTTPS_PORT=8443
SSL_CERTFILE=certs/localhost.pem
SSL_KEYFILE=certs/localhost-key.pem

# Секреты поставляются отдельно и не хранятся в Git:
# LAB_DB_PASSWORD -> secrets/lab_db_password
# AUTH_SECRET     -> secrets/auth_secret
