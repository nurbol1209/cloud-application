APP_NAME=Cloud Application
APP_VERSION=1.0
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true
API_PREFIX=/api

# PostgreSQL (целевая СУБД проекта):
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/cloud_application

# Локальный режим без установленного PostgreSQL:
DATABASE_URL=sqlite:///./cloud_application.db

# Файловое хранилище объектов
STORAGE_PATH=storage/objects
MAX_UPLOAD_SIZE=5242880

# HTTPS / TLS
HTTPS_ENABLED=true
HTTPS_PORT=8443
SSL_CERTFILE=certs/localhost.pem
SSL_KEYFILE=certs/localhost-key.pem
